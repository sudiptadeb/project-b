# The first app: one library holding content and the C++ adapter, and two thin binaries
# that load it. See docs/first-app.md.

import("//build/config/mac/mac_sdk.gni")
import("//project_b/engine/flags.gni")
import("//third_party/inspector_protocol/inspector_protocol.gni")
import("//tools/grit/repack.gni")
if (project_b_extensions) {
  import("//tools/json_schema_compiler/json_features.gni")
  import("//tools/json_schema_compiler/json_schema_api.gni")
}

assert(is_mac, "The first app is Mac only so far")

declare_args() {
  project_b_go = "/opt/homebrew/bin/go"
}

# The Go core as a static archive. Only the main binary links it, so child processes
# never start a Go runtime.
action("go_core") {
  script = "build_go.py"
  outputs = [ "$target_gen_dir/libcore.a" ]
  depfile = "$target_gen_dir/core.d"
  args = [
    project_b_go,
    rebase_path("$target_gen_dir/libcore.a", root_build_dir),
    rebase_path(depfile, root_build_dir),
    mac_deployment_target,
  ]

  # Each build flag the build has is a Go build tag of the same name.
  args += project_b_built
}

source_set("go_core_lib") {
  public_deps = [ ":go_core" ]
  libs = [ "$target_gen_dir/libcore.a" ]
  frameworks = [
    "CoreFoundation.framework",
    "Security.framework",
  ]
}

# What every process needs from the adapter.
source_set("common") {
  sources = [
    "common/content_client.cc",
    "common/content_client.h",
    "common/extensions_on.h",
    "common/main_delegate.cc",
    "common/main_delegate.h",
  ]
  deps = [
    "//base",
    "//content/public/app",
    "//content/public/common",
    "//project_b/engine/buildflags",
    "//ui/base",
  ]

  # In a build with extensions, every process knows the chrome-extension: scheme and
  # which APIs exist, a renderer runs //extensions' bindings and content scripts, and a
  # utility process unzips packages.
  if (project_b_extensions) {
    sources += [
      "extensions/common/extensions_client.cc",
      "extensions/common/extensions_client.h",
      "extensions/renderer/content_renderer_client.cc",
      "extensions/renderer/content_renderer_client.h",
      "extensions/utility/content_utility_client.cc",
      "extensions/utility/content_utility_client.h",
    ]
    deps += [
      ":extension_api_features",
      ":extension_api_schemas",
      ":extension_permission_features",
      "//components/services/unzip:lib",
      "//components/services/unzip/public/mojom",
      "//content/public/renderer",
      "//content/public/utility",
      "//extensions/common",
      "//extensions/common:core_api_provider",
      "//extensions/renderer",
      "//mojo/public/cpp/bindings",
      "//third_party/blink/public:blink",
    ]
  }
}

if (project_b_extensions) {
  # The browser's own extension APIs, which Go answers. Their schemas are Chrome's
  # files, used where they are; where each API appears is ours to say.
  generated_json_strings("extension_api_schemas") {
    sources = [
      "//chrome/common/extensions/api/action.json",
      "//chrome/common/extensions/api/commands.json",
      "//chrome/common/extensions/api/tabs.json",
      "//chrome/common/extensions/api/windows.json",
    ]

    # The compiler writes beside the schemas' folder as seen from root, and this puts
    # that in our own generated folder.
    root = "//chrome/common/extensions/api"
    target_prefix = rebase_path(target_gen_dir, root_gen_dir)
    bundle_name = "ProjectB"
    root_namespace = "project_b::api::%(namespace)s"
  }

  json_features("extension_api_features") {
    feature_type = "APIFeature"
    method_name = "AddProjectBAPIFeatures"
    sources = [ "extensions/common/api_features.json" ]
  }

  json_features("extension_permission_features") {
    feature_type = "PermissionFeature"
    method_name = "AddProjectBPermissionFeatures"
    sources = [ "extensions/common/permission_features.json" ]
  }
}

# The DevTools commands content leaves to the embedder that we answer: Browser's window
# commands. Generated from Blink's protocol the way content_shell's are
# (content/shell/BUILD.gn); browser/protocol_config.json picks the commands.
inspector_protocol_generate("protocol_sources") {
  visibility = [ ":browser" ]
  deps = [ "//third_party/blink/public/devtools_protocol:protocol_version" ]
  _blink_protocol_path = rebase_path(
          "$root_gen_dir/third_party/blink/public/devtools_protocol/protocol.json",
          root_build_dir)

  inspector_protocol_dir = "//third_party/inspector_protocol"
  out_dir = "$target_gen_dir/browser"
  config_file = "browser/protocol_config.json"
  config_values = [ "protocol.path=$_blink_protocol_path" ]
  use_embedder_types = true

  inputs = [
    "$root_gen_dir/third_party/blink/public/devtools_protocol/protocol.json",
    config_file,
  ]

  # These are relative to out_dir.
  outputs = [
    "protocol/browser.cc",
    "protocol/browser.h",
    "protocol/protocol.h",
  ]
}

# The C++ adapter. Each function is thin and forwards to the Go core, through the table
# in browser/go.h, so nothing here links to Go.
source_set("browser") {
  sources = [
    "abi/pb_abi.h",
    "browser/browser_context.cc",
    "browser/browser_context.h",
    "browser/browser_main_parts.h",
    "browser/browser_main_parts.mm",
    "browser/child_processes.cc",
    "browser/child_processes.h",
    "browser/content_browser_client.cc",
    "browser/content_browser_client.h",
    "browser/devtools.cc",
    "browser/devtools.h",
    "browser/devtools_session.cc",
    "browser/devtools_session.h",
    "browser/driver.h",
    "browser/driver.mm",
    "browser/engine.cc",
    "browser/engine.h",
    "browser/go.cc",
    "browser/go.h",
    "browser/hooks.cc",
    "browser/hooks.h",
    "browser/hooks_gen.cc",
    "browser/hooks_gen.h",
    "browser/mac_app.h",
    "browser/mac_app.mm",
    "browser/page_tab.cc",
    "browser/page_tab.h",
    "browser/settings_page.cc",
    "browser/settings_page.h",
    "browser/shell_page.cc",
    "browser/shell_page.h",
    "browser/window.h",
    "browser/window_mac.mm",
    "browser_main_delegate.cc",
    "browser_main_delegate.h",
  ]
  sources += get_target_outputs(":protocol_sources")
  deps = [
    ":common",
    ":protocol_sources",
    "//base",
    "//components/embedder_support:user_agent",
    "//components/input",
    "//components/version_info:version_info_with_user_agent",
    "//components/viz/common",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//net",
    "//project_b/engine/buildflags",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//skia",
    "//third_party/blink/public/common",
    "//third_party/blink/public/mojom:mojom_platform",
    "//third_party/inspector_protocol:crdtp",
    "//ui/base",
    "//ui/display",
    "//ui/events",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/latency",
    "//url",
  ]
  frameworks = [
    "AppKit.framework",
    "Cocoa.framework",
  ]

  # The extension runtime: Chromium's //extensions, and our embedder for it.
  if (project_b_extensions) {
    sources += [
      "abi/pb_extensions_abi.h",
      "extensions/browser/api_client.cc",
      "extensions/browser/api_client.h",
      "extensions/browser/choose_path.h",
      "extensions/browser/choose_path_mac.mm",
      "extensions/browser/content_hooks.cc",
      "extensions/browser/extension_system.cc",
      "extensions/browser/extension_system.h",
      "extensions/browser/extensions.cc",
      "extensions/browser/extensions.h",
      "extensions/browser/extensions_browser_client.cc",
      "extensions/browser/extensions_browser_client.h",
      "extensions/browser/go_function.cc",
      "extensions/browser/go_function.h",
      "extensions/browser/management_delegate.cc",
      "extensions/browser/management_delegate.h",
      "extensions/browser/popup.cc",
      "extensions/browser/popup.h",
      "extensions/browser/web_contents_observer.cc",
      "extensions/browser/web_contents_observer.h",
    ]
    deps += [
      "//components/crx_file",
      "//components/custom_handlers",
      "//components/download/public/common:public",
      "//components/enterprise/browser/promotion:prefs",
      "//components/image_fetcher/core",
      "//components/keyed_service/content",
      "//components/pref_registry",
      "//components/prefs",
      "//components/update_client",
      "//components/user_prefs",
      "//components/value_store",
      "//extensions/browser",
      "//extensions/browser:crx_installer",
      "//extensions/browser:webstore_installer",
      "//services/data_decoder/public/cpp",
      "//extensions/common",
      "//extensions/common/api",
      "//extensions/common:mojom",
    ]
    frameworks += [ "UniformTypeIdentifiers.framework" ]
  }
  configs += [ "//build/config/compiler:no_exit_time_destructors" ]
}

repack("pak") {
  sources = [
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/mojo/public/js/mojo_bindings_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
  ]
  deps = [
    "//content:content_resources",
    "//mojo/public/js:resources",
    "//net:net_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//ui/resources",
    "//ui/strings",
  ]
  if (project_b_extensions) {
    sources += [
      "$root_gen_dir/extensions/extensions_browser_resources_100_percent.pak",
      "$root_gen_dir/extensions/extensions_renderer_generated_resources.pak",
      "$root_gen_dir/extensions/extensions_renderer_resources.pak",
      "$root_gen_dir/extensions/extensions_resources.pak",
      "$root_gen_dir/extensions/strings/extensions_strings_en-US.pak",
    ]
    deps += [
      "//extensions:extensions_resources",
      "//extensions/strings",
    ]
  }
  output = "$root_out_dir/project_b.pak"
}

group("engine") {
  deps = [
    ":project_b",
    ":project_b_helper",
  ]
}

# Content and the C++ adapter. Both binaries link this at load time and call its one
# export, ProjectBMain. Everything else in it stays hidden.
shared_library("project_b_content") {
  sources = [
    "abi/pb_main.h",
    "project_b_main.cc",
  ]
  deps = [
    ":browser",
    ":common",
    ":pak",
    "//base",
    "//content/public/app",
    "//content/public/common",
    "//sandbox/mac:seatbelt",
  ]
  data_deps = [ "//tools/v8_context_snapshot" ]
  ldflags = [
    "-Wl,-exported_symbol,_ProjectBMain",
    "-Wl,-install_name,@rpath/libproject_b_content.dylib",
  ]
}

# Where the binaries find the library: Contents/Frameworks in the app, or beside them in
# the build folder.
config("finds_content_library") {
  ldflags = [
    "-Wl,-rpath,@executable_path/../Frameworks",
    "-Wl,-rpath,@executable_path",
  ]
}

# Main process: Go, and the library for everything else.
executable("project_b") {
  sources = [
    "abi/pb_exports.h",
    "app/main.cc",
  ]
  configs += [ ":finds_content_library" ]
  deps = [
    ":go_core_lib",
    ":project_b_content",
  ]
  data_deps = [ ":project_b_helper" ]
}

# Child processes: the library, no Go.
executable("project_b_helper") {
  sources = [ "app/helper_main.cc" ]
  configs += [ ":finds_content_library" ]
  deps = [ ":project_b_content" ]
}
