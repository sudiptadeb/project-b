#!/usr/bin/python3 -I
"""Run deskctl inside the logged-in desktop session and print what it printed.

Agent and ssh sessions on a Mac live in a Background session with no display, so
deskctl runs as a one-shot launchd job in the desktop's gui domain instead.
deskctl must be the job's own program: macOS checks permissions against the
process launchd started, so a shell in between would be the one it checks.
"""
import os
import plistlib
import subprocess
import sys
import tempfile
import time

# deskctl sits next to this wrapper, wherever install.sh put both.
DESKCTL = os.path.join(os.path.dirname(os.path.realpath(__file__)), "deskctl")
DOMAIN = "gui/%d" % os.getuid()
LABEL = "dev.local.desk.%d" % os.getpid()
LIMIT_SECONDS = 40


def launchctl(*args):
    return subprocess.run(["launchctl", *args], capture_output=True, text=True)


with tempfile.TemporaryDirectory() as work:
    out = os.path.join(work, "out")
    err = os.path.join(work, "err")
    plist = os.path.join(work, "job.plist")
    with open(plist, "wb") as f:
        plistlib.dump(
            {
                "Label": LABEL,
                "ProgramArguments": [DESKCTL, *sys.argv[1:]],
                "RunAtLoad": True,
                "LimitLoadToSessionType": "Aqua",
                "StandardOutPath": out,
                "StandardErrorPath": err,
            },
            f,
        )

    started = launchctl("bootstrap", DOMAIN, plist)
    if started.returncode != 0:
        sys.exit("can't start in the desktop session (nobody logged in?): " + started.stderr.strip())

    code = None
    deadline = time.time() + LIMIT_SECONDS
    while time.time() < deadline:
        state = launchctl("print", "%s/%s" % (DOMAIN, LABEL)).stdout
        if "state = running" not in state and "last terminating signal" in state:
            code = 1
            break
        if "state = running" not in state and "last exit code = " in state:
            value = state.split("last exit code = ", 1)[1].split("\n", 1)[0].strip()
            if value.isdigit():
                code = int(value)
                break
        time.sleep(0.1)
    launchctl("bootout", "%s/%s" % (DOMAIN, LABEL))

    for path, stream in ((out, sys.stdout), (err, sys.stderr)):
        if os.path.exists(path):
            stream.write(open(path).read())

    if code is None:
        sys.exit("deskctl didn't finish in %d seconds" % LIMIT_SECONDS)
    sys.exit(code)
