<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The default frame colour, until Go gives the window the one in the prefs. -->
    <color name="frame">#4f9e9e</color>

    <style name="Window" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/frame</item>
        <item name="android:navigationBarColor">#ffffff</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Shows wherever a camera cutout pushes the app away from the screen edge. -->
        <item name="android:windowBackground">@color/frame</item>
        <!-- Without this, Android 16 letterboxes the app below a camera cutout, and the status bar goes black. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
