{
  "manifest_version": 3,
  "name": "Project B test extension",
  "version": "1.0",
  "description": "Exercises an action popup, a content script, storage, tabs and messaging.",
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "Project B test extension" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }],
  "permissions": ["storage", "tabs"]
}
